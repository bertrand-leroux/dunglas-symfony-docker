# Symfony Docker Environment Configuration

# Server Configuration
# For development, use app.localhost
# For production, use your actual domain name
SERVER_NAME=app.localhost

# HTTP/HTTPS Ports
HTTP_PORT=80
HTTPS_PORT=443
HTTP3_PORT=443

# Symfony Configuration
# Generate with: openssl rand -hex 32
# REQUIRED in production, optional in development
APP_SECRET=

# Mercure Hub Configuration
# Generate with: openssl rand -base64 64
CADDY_MERCURE_JWT_SECRET=!ChangeThisMercureHubJWTSecretKey!

# CORS Configuration for Mercure (production)
# Comma-separated list of allowed origins
# CORS_ORIGINS=https://example.com,https://www.example.com

# Let's Encrypt Configuration (production only)
# REQUIRED for automatic HTTPS certificates in production
# ACME_EMAIL=your-email@example.com

# Database Configuration
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=!ChangeMe!
POSTGRES_VERSION=15
POSTGRES_CHARSET=utf8

# Symfony Version (for initial installation)
SYMFONY_VERSION=
STABILITY=stable

# Development Configuration
XDEBUG_MODE=off
APP_ENV=dev

# Docker Image Prefix (optional)
# Useful for custom registry
# IMAGES_PREFIX=registry.example.com/
